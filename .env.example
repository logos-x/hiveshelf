# ==================================================
# PostgreSQL - Local Development Only
# ==================================================
POSTGRES_USER=hiveshelf
POSTGRES_PASSWORD=hiveshelf_dev
POSTGRES_DB=hiveshelf
POSTGRES_DB_TEST=hiveshelf_test
POSTGRES_PORT=5432

DATABASE_URL=postgresql://hiveshelf:hiveshelf_dev@localhost:5432/hiveshelf
DATABASE_URL_TEST=postgresql://hiveshelf:hiveshelf_dev@localhost:5432/hiveshelf_test

# ==================================================
# S3 Compatible Storage - Local Development Only
# ==================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=hiveshelf
S3_SECRET_KEY=hiveshelf_dev_secret
S3_BUCKET=hiveshelf-dev
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==================================================
# Mail - Mailpit
# ==================================================
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM="HiveShelf <no-reply@hiveshelf.local>"

# ==================================================
# Application
# ==================================================
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001

LOG_LEVEL=info

# WARNING:
# All credentials above are for local development only.
# NEVER reuse them in staging or production.
