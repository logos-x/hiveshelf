{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_SITE_URL", "API_INTERNAL_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hiveshelf/api#db:generate": {
      "cache": false
    },
    "@hiveshelf/api#build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**"]
    },
    "@hiveshelf/api#typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "@hiveshelf/api#dev": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "persistent": true
    },
    "@hiveshelf/api#test": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["DATABASE_URL", "DATABASE_URL_TEST", "NODE_ENV"]
    }
  }
}
