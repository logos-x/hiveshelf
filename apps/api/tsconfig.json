{
  "extends": "@hiveshelf/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src",
    "test",
    "vitest.config.ts",
    "prisma.config.ts",
    "scripts",
    "prisma/seed.ts"
  ]
}
