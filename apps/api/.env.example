# API-specific configuration. Shared DB/S3/SMTP settings come from ../../.env.
# Priority: process environment > .env.local > .env > ../../.env.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
STORAGE_DRIVER=s3
EMAIL_DRIVER=smtp

# Temporary cookie-auth spike; never enable in production.
AUTH_SPIKE_ENABLED=false

# Local spike B only. Leave unset for host-only cookies in A.
# AUTH_SPIKE_COOKIE_DOMAIN=hiveshelf.test
